-- ===================== SCAN BRAINROTS =====================
local function scanForHighValueBrainrot()
    local animals = CollectionService:GetTagged("Animal")
    for _, model in ipairs(animals) do
        local index = model:GetAttribute("Index")
        if index then
            local animal = AnimalsData[index]
            if animal and animal.Price and animal.Price > MIN_PRICE then
                local name = animal.DisplayName or index
                return true, animal.Price, name
            end
        end
    end
    return false
end

-- ===================== ALERT SOUND =====================
local function playAlert()
    local sound = Instance.new("Sound")
    sound.SoundId = ALERT_SOUND_ID
    sound.Volume = 1
    sound.Parent = SoundService
    sound:Play()
    sound.Ended:Connect(function()
        sound:Destroy()
    end)
end

-- ===================== GET AVAILABLE SERVERS =====================
local function getAvailableServers()
    -- Fetch friend list to exclude their servers (optional)
    local friendIds = {}
    local success, pages = pcall(function()
        return Players:GetFriendsAsync(player.UserId)
    end)
    if success then
        repeat
            for _, friend in ipairs(pages:GetCurrentPage()) do
                friendIds[friend.Id] = true
            end
            if pages.IsFinished then break end
            pages:AdvanceToNextPageAsync()
        until false
    end

    -- Fetch server list
    if not httpRequest then
        warn("No HTTP request function available. Hopping disabled.")
        return {}
    end
    local url = "https://games.roblox.com/v1/games/" .. game.GameId .. "/servers/Public?sortOrder=Desc&limit=100"
    local response = httpRequest({ Url = url, Method = "GET" })
    local result = HttpService:JSONDecode(response.Body)
    if not result or not result.data then return {} end

    local servers = {}
    for _, srv in ipairs(result.data) do
        -- Skip full servers
        if srv.playing >= srv.maxPlayers then continue end
        -- Skip current server
        if srv.id == lastServerId then continue end
        -- Optional: only same maxPlayers as our target
        if srv.maxPlayers ~= MAX_PLAYERS then continue end
        -- Add
        table.insert(servers, srv)
    end

    -- Sort by most players descending
    table.sort(servers, function(a, b) return a.playing > b.playing end)
    return servers
end

-- ===================== SERVER HOP =====================
local function hopServer()
    local servers = getAvailableServers()
    if #servers == 0 then
        statusText.Text = "No servers found, retrying..."
        return false
    end

    for _, srv in ipairs(servers) do
        lastServerId = srv.id  -- prevent rejoin
        local success, err = pcall(function()
            TeleportService:TeleportToPlaceInstance(PLACE_ID, srv.id, player)
        end)
        if success then
            return true
        end
        task.wait(0.5)
    end
    statusText.Text = "All servers failed, retrying..."
    return false
end

-- ===================== HOPPING LOOP =====================
hoppingLoop = function()
    while hopping do
        -- Wait scan delay, checking frequently
        local waited = 0
        while waited < SCAN_DELAY and hopping do
            task.wait(1)
            waited = waited + 1
            local foundNow, price, name = scanForHighValueBrainrot()
            if foundNow then
                found = true
                hopping = false
                statusText.Text = "Found! " .. name .. " ($" .. tostring(price) .. ")"
                playAlert()
                startBtn.Text = "START HOPPING"
                startBtn.BackgroundColor3 = Color3.fromRGB(255,215,0)
                return
            end
            statusText.Text = "Scanning... (" .. (SCAN_DELAY - waited) .. "s left)"
        end

        if hopping then
            local foundNow, price, name = scanForHighValueBrainrot()
            if foundNow then
                found = true
                hopping = false
                statusText.Text = "Found! " .. name .. " ($" .. tostring(price) .. ")"
                playAlert()
                startBtn.Text = "START HOPPING"
                startBtn.BackgroundColor3 = Color3.fromRGB(255,215,0)
                return
            end
            -- Hop
            statusText.Text = "Hopping server..."
            local hopped = hopServer()
            if not hopped then
                statusText.Text = "Hop failed, retrying..."
                task.wait(2)
            end
        end
    end
end

