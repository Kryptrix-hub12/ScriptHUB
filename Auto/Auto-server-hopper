-- ===================== SCAN BRAINROTS =====================
local function scanForHighValueBrainrot()
    local animals = CollectionService:GetTagged("Animal")
    for _, model in ipairs(animals) do
        local index = model:GetAttribute("Index")
        if index and AnimalsData[index] then
            local price = AnimalsData[index].Price or 0
            if price > MIN_PRICE then
                return true, price, index
            end
        end
    end
    return false
end

-- ===================== ALERT SOUND =====================
local function playAlert()
    local sound = Instance.new("Sound")
    sound.SoundId = ALERT_SOUND_ID
    sound.Volume = 1
    sound.Parent = SoundService
    sound:Play()
    task.delay(2, function() sound:Destroy() end)
end

-- ===================== SERVER HOPPING =====================
local function getAvailableServers()
    -- Fetch friend list to later exclude their servers (limited)
    local friendIds = {}
    pcall(function()
        local success, friends = pcall(Players.GetFriendsAsync, player, 200)
        if success then
            for _, friend in ipairs(friends) do
                friendIds[friend.Id] = true
            end
        end
    end)

    -- Fetch server list
    local url = "https://games.roblox.com/v1/games/" .. game.GameId .. "/servers/Public?sortOrder=Desc&limit=100"
    local success, result = pcall(function()
        return HttpService:JSONDecode(HttpService:GetAsync(url))
    end)
    if not success or not result or not result.data then return {} end

    local servers = {}
    for _, srv in ipairs(result.data) do
        -- Skip full servers (playing >= max players)
        if srv.playing >= srv.maxPlayers then continue end
        -- Skip current server (lastServerId)
        if srv.id == lastServerId then continue end
        -- Skip servers with 0 players? (they said no bacon avatars, but we can't really check; skip 0 to be safe)
        if srv.playing < 1 then continue end
        -- Skip servers that contain friends (impossible without player list, so ignore)
        -- Add to list
        table.insert(servers, srv)
    end

    -- Sort by descending player count (to join the most active server)
    table.sort(servers, function(a, b) return a.playing > b.playing end)
    return servers
end

local function hopServer()
    local servers = getAvailableServers()
    if #servers == 0 then
        statusText.Text = "No servers found, retrying..."
        return false
    end

    -- Try each server until one succeeds
    for _, srv in ipairs(servers) do
        local success, err = pcall(function()
            TeleportService:TeleportToPlaceInstance(PLACE_ID, srv.id, player)
        end)
        if success then
            -- Teleport initiates; the game will reload. We won't reach here after successful teleport.
            -- But if it fails, we continue to next server.
            return true
        end
        task.wait(0.5)  -- small delay between attempts
    end
    statusText.Text = "All servers failed, retrying..."
    return false
end

-- ===================== HOPPING LOOP =====================
function hoppingLoop()
    while hopping do
        -- Wait SCAN_DELAY seconds, checking for brainrots
        local waited = 0
        while waited < SCAN_DELAY and hopping do
            task.wait(1)
            waited = waited + 1
            -- Early scan: if we find a high-value brainrot, stop immediately
            local foundNow, price, name = scanForHighValueBrainrot()
            if foundNow then
                found = true
                hopping = false
                statusText.Text = "Found! " .. name .. " ($" .. tostring(price) .. ")"
                playAlert()
                startBtn.Text = "START HOPPING"
                startBtn.BackgroundColor3 = Color3.fromRGB(255,215,0)
                return
            end
            statusText.Text = "Scanning... (" .. (SCAN_DELAY - waited) .. "s left)"
        end

        -- If still hopping after delay, scan one final time
        if hopping then
            local foundNow, price, name = scanForHighValueBrainrot()
            if foundNow then
                found = true
                hopping = false
                statusText.Text = "Found! " .. name .. " ($" .. tostring(price) .. ")"
                playAlert()
                startBtn.Text = "START HOPPING"
                startBtn.BackgroundColor3 = Color3.fromRGB(255,215,0)
                return
            end
            -- Hop to a new server
            statusText.Text = "Hopping server..."
            local hopped = hopServer()
            if not hopped then
                statusText.Text = "Hop failed, retrying..."
                task.wait(2)
            end
        end
    end
end

