-- ===================== HTTP REQUEST FUNCTION =====================
local httpRequest = nil
for _, func in ipairs({"syn.request", "http.request", "request", "http_request", "syn_http_request"}) do
    local success, f = pcall(function() return loadstring("return " .. func)() end)
    if success and type(f) == "function" then
        httpRequest = f
        print("[Hopper] Using HTTP function: " .. func)
        break
    end
end
if not httpRequest then
    warn("[Hopper] No HTTP request function found. Will use random teleport.")
end

