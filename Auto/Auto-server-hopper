-- ===================== SCAN BRAINROTS =====================
local function scanForHighValueBrainrot()
    local animals = CollectionService:GetTagged("Animal")
    for _, model in ipairs(animals) do
        local index = model:GetAttribute("Index")
        if index then
            local animal = AnimalsData[index]
            if animal and animal.Price and animal.Price > MIN_PRICE then
                local name = animal.DisplayName or index
                return true, animal.Price, name
            end
        end
    end
    return false
end

-- ===================== ALERT =====================
local function playAlert(name, price)
    local sound = Instance.new("Sound")
    sound.SoundId = ALERT_SOUND_ID
    sound.Volume = 1
    sound.Parent = SoundService
    sound:Play()
    sound.Ended:Connect(function()
        sound:Destroy()
    end)
    showNotification("🔥 Valuable Brainrot Found!", name .. " ($" .. tostring(price) .. ")", 5)
end

-- ===================== RANDOM HOP (fallback) =====================
local function randomHop()
    lastServerId = game.JobId
    pcall(function()
        TeleportService:Teleport(PLACE_ID, player)
    end)
end

-- ===================== SERVER HOP WITH HTTP (random pick) =====================
local function hopServer()
    if httpRequest then
        local url = "https://games.roblox.com/v1/games/" .. game.GameId .. "/servers/Public?sortOrder=Desc&limit=100"
        local response = httpRequest({ Url = url, Method = "GET" })
        local body = response.Body or response.body
        if body then
            local result = HttpService:JSONDecode(body)
            if result and result.data then
                local servers = {}
                for _, srv in ipairs(result.data) do
                    if srv.playing < srv.maxPlayers and srv.id ~= lastServerId and srv.maxPlayers == MAX_PLAYERS then
                        table.insert(servers, srv)
                    end
                end
                if #servers > 0 then
                    local srv = servers[math.random(#servers)]
                    lastServerId = srv.id
                    TeleportService:TeleportToPlaceInstance(PLACE_ID, srv.id, player)
                    return true
                end
            end
        end
    end
    randomHop()
    return true
end

-- ===================== HOPPING LOOP =====================
local hoppingLoop
hoppingLoop = function()
    while hopping do
        local waited = 0
        while waited < SCAN_DELAY and hopping do
            task.wait(1)
            waited = waited + 1
            local icons = {"🔍", "🔎"}
            scanIndicator.Text = icons[waited % 2 + 1]
            local foundNow, price, name = scanForHighValueBrainrot()
            if foundNow then
                found = true
                hopping = false
                statusText.Text = "Found! " .. name .. " ($" .. tostring(price) .. ")"
                scanIndicator.Visible = false
                playAlert(name, price)
                startBtn.Text = "START HOPPING"
                startBtn.BackgroundColor3 = Color3.fromRGB(0,255,200)
                return
            end
            statusText.Text = "Scanning... (" .. (SCAN_DELAY - waited) .. "s left)"
        end

        if hopping then
            local foundNow, price, name = scanForHighValueBrainrot()
            if foundNow then
                found = true
                hopping = false
                statusText.Text = "Found! " .. name .. " ($" .. tostring(price) .. ")"
                scanIndicator.Visible = false
                playAlert(name, price)
                startBtn.Text = "START HOPPING"
                startBtn.BackgroundColor3 = Color3.fromRGB(0,255,200)
                return
            end
            statusText.Text = "Hopping to random server..."
            hopServer()
        end
    end
end

