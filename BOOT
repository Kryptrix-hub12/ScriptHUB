local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")

local function findGuiParent()
    if type(gethui) == "function" then
        local ok, h = pcall(gethui)
        if ok and h then return h end
    end
    local ok, players = pcall(function() return game:GetService("Players") end)
    if ok and players then
        local lp = players.LocalPlayer
        if lp then
            local ok2, pg = pcall(function()
                return lp:WaitForChild("PlayerGui", 5)
            end)
            if ok2 and pg then return pg end
        end
    end
    return nil
end

local function createGUI()
    local parent = findGuiParent()
    if not parent then
        warn("[gojo] no GUI parent")
        return nil
    end

    local screen = Instance.new("ScreenGui")
    screen.Name = "GojoDumper"
    screen.ResetOnSpawn = false
    screen.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    screen.IgnoreGuiInset = true

    if type(syn) == "table" and syn.protect_gui then
        pcall(syn.protect_gui, screen)
    end
    if type(protect_gui) == "function" then
        pcall(protect_gui, screen)
    end

    screen.Parent = parent

    -- Modern blur effect
    local blur = Instance.new("BlurEffect")
    blur.Size = 0
    blur.Parent = Lighting

    -- Tween blur in
    TweenService:Create(blur, TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = 18,
    }):Play()

    -- Main frame
    local frame = Instance.new("Frame")
    frame.Name = "Main"
    frame.Size = UDim2.new(0, 0, 0, 0)
    frame.Position = UDim2.new(0.5, 0, 0.5, 0)
    frame.AnchorPoint = Vector2.new(0.5, 0.5)
    frame.BackgroundColor3 = Color3.fromRGB(10, 10, 14)
    frame.BackgroundTransparency = 1
    frame.BorderSizePixel = 0
    frame.Active = true
    frame.Draggable = true
    frame.Parent = screen

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 14)
    corner.Parent = frame

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1
    stroke.Color = Color3.fromRGB(50, 90, 150)
    stroke.Transparency = 1
    stroke.Parent = frame

    -- Gradient for modern look
    local grad = Instance.new("UIGradient")
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(12, 12, 20)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(18, 22, 35)),
    })
    grad.Rotation = 45
    grad.Parent = frame

    -- Textbox
    local textbox = Instance.new("TextBox")
    textbox.Name = "Input"
    textbox.Size = UDim2.new(1, -20, 0, 100)
    textbox.Position = UDim2.new(0, 10, 0, 10)
    textbox.BackgroundColor3 = Color3.fromRGB(15, 15, 22)
    textbox.BackgroundTransparency = 0.2
    textbox.BorderSizePixel = 0
    textbox.Text = ""
    textbox.PlaceholderText = "Loadstring..."
    textbox.PlaceholderColor3 = Color3.fromRGB(90, 95, 110)
    textbox.TextColor3 = Color3.fromRGB(230, 230, 240)
    textbox.Font = Enum.Font.Code
    textbox.TextSize = 13
    textbox.TextXAlignment = Enum.TextXAlignment.Left
    textbox.TextYAlignment = Enum.TextYAlignment.Top
    textbox.TextWrapped = true
    textbox.ClearTextOnFocus = false
    textbox.MultiLine = true
    textbox.TextTransparency = 1
    textbox.Parent = frame

    local tbCorner = Instance.new("UICorner")
    tbCorner.CornerRadius = UDim.new(0, 8)
    tbCorner.Parent = textbox

    local tbStroke = Instance.new("UIStroke")
    tbStroke.Thickness = 1
    tbStroke.Color = Color3.fromRGB(40, 40, 55)
    tbStroke.Transparency = 0.3
    tbStroke.Parent = textbox

    local tbPad = Instance.new("UIPadding")
    tbPad.PaddingTop = UDim.new(0, 8)
    tbPad.PaddingBottom = UDim.new(0, 8)
    tbPad.PaddingLeft = UDim.new(0, 8)
    tbPad.PaddingRight = UDim.new(0, 8)
    tbPad.Parent = textbox

    -- Button
    local button = Instance.new("TextButton")
    button.Name = "Execute"
    button.Size = UDim2.new(1, -20, 0, 44)
    button.Position = UDim2.new(0, 10, 0, 120)
    button.BackgroundColor3 = Color3.fromRGB(45, 130, 220)
    button.BorderSizePixel = 0
    button.Text = "EXECUTE"
    button.TextColor3 = Color3.fromRGB(255, 255, 255)
    button.Font = Enum.Font.GothamBold
    button.TextSize = 16
    button.TextTransparency = 1
    button.AutoButtonColor = false
    button.Parent = frame

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 10)
    btnCorner.Parent = button

    local btnGrad = Instance.new("UIGradient")
    btnGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(55, 140, 235)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(35, 110, 200)),
    })
    btnGrad.Rotation = 90
    btnGrad.Parent = button

    -- Popup animation: fade in + scale up
    spawnFn(function()
        TweenService:Create(frame, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
            Size = UDim2.new(0, 400, 0, 184),
            BackgroundTransparency = 0.05,
        }):Play()

        TweenService:Create(stroke, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            Transparency = 0.3,
        }):Play()

        waitFn(0.15)

        TweenService:Create(textbox, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            TextTransparency = 0,
        }):Play()

        waitFn(0.1)

        TweenService:Create(button, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            TextTransparency = 0,
        }):Play()
    end)

    local running = false

    local function setButtonState(state)
        if state == "idle" then
            TweenService:Create(button, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundColor3 = Color3.fromRGB(45, 130, 220),
            }):Play()
            button.Text = "EXECUTE"
        elseif state == "working" then
            TweenService:Create(button, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundColor3 = Color3.fromRGB(30, 90, 170),
            }):Play()
            button.Text = "Working..."
        elseif state == "done" then
            TweenService:Create(button, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundColor3 = Color3.fromRGB(45, 200, 100),
            }):Play()
            button.Text = "Done deobfuscated"
        elseif state == "failed" then
            TweenService:Create(button, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundColor3 = Color3.fromRGB(200, 60, 60),
            }):Play()
            button.Text = "Failed"
        elseif state == "nowrite" then
            TweenService:Create(button, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
                BackgroundColor3 = Color3.fromRGB(220, 170, 50),
            }):Play()
            button.Text = "No writefile"
        end
    end

    button.MouseButton1Click:Connect(function()
        if running then return end
        local text = textbox.Text
        if type(text) ~= "string" or #text < 3 then
            setButtonState("failed")
            waitFn(2)
            setButtonState("idle")
            return
        end

        running = true
        setButtonState("working")

        spawnFn(function()
            local ok, saved = pcall(runPipeline, text)

            if ok and saved then
                setButtonState("done")
                waitFn(2)
            elseif ok and not saved then
                setButtonState("nowrite")
                waitFn(2)
            else
                setButtonState("failed")
                waitFn(2)
            end

            setButtonState("idle")
            running = false
        end)
    end)

    return screen, blur
end

