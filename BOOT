function VM.liftLuraph(chunk)
    if not chunk then return "-- (no chunk)" end
    local out = {}
    out[#out+1] = "-- Luraph VM disassembly"
    out[#out+1] = rawFormat("-- encoder=%s profile=%s score=%d",
        tostring(chunk.encoder), tostring(chunk.profile.name), chunk.score or 0)
    out[#out+1] = rawFormat("-- protos=%d constants=%d entry=%s",
        #chunk.prototypes, #chunk.constants, tostring(chunk.entryIndex))
    out[#out+1] = ""

    out[#out+1] = "-- ====== CONSTANT POOL ======"
    local shown = 0
    for i, c in ipairs(chunk.constants) do
        if shown >= 800 then
            out[#out+1] = rawFormat("-- (%d more constants)", #chunk.constants - shown)
            break
        end
        shown = shown + 1
        local repr
        if c.type == "string" then
            local v = c.value or ""
            if #v > 150 then v = rawSub(v, 1, 147) .. "..." end
            repr = rawFormat("%q", v)
        else
            repr = tostring(c.value)
        end
        out[#out+1] = rawFormat("-- C[%05d] %-8s %s", i, c.type, repr)
    end

    for pi, proto in ipairs(chunk.prototypes) do
        out[#out+1] = ""
        out[#out+1] = rawFormat("-- ====== PROTO %s (instrs=%d stack=%s params=%s) ======",
            tostring(proto.name), proto.instructionCount,
            tostring(proto.stackSize), tostring(proto.numParams))

        local limit = math.min(proto.instructionCount, 400)
        for idx = 1, limit do
            local op = proto.opcodes[idx]
            local r = proto.raw[idx] or {}
            local sem = OPCODE_NAMES[op] or "?"
            out[#out+1] = rawFormat("  [%05d] OP_%03d %-16s A=%-6s B=%-6s C=%-6s",
                idx, op, sem, tostring(r.A), tostring(r.B), tostring(r.C))
        end

        if proto.instructionCount > limit then
            out[#out+1] = rawFormat("  -- (%d more instructions)",
                proto.instructionCount - limit)
        end
    end

    return rawConcat(out, "\n")
end

