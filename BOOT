local function parseLuaByteString(s)
    local out = {}
    local i = 1
    while i <= #s do
        local c = rawByte(s, i)
        if c == 92 then
            local nxt = rawByte(s, i+1)
            if nxt == 110 then
                out[#out+1] = 10
                i = i + 2
            elseif nxt == 116 then
                out[#out+1] = 9
                i = i + 2
            elseif nxt == 114 then
                out[#out+1] = 13
                i = i + 2
            elseif nxt == 34 then
                out[#out+1] = 34
                i = i + 2
            elseif nxt == 92 then
                out[#out+1] = 92
                i = i + 2
            elseif nxt and nxt >= 48 and nxt <= 57 then
                local digits = ""
                local j = i + 1
                while j <= #s and #digits < 3 do
                    local d = rawByte(s, j)
                    if d >= 48 and d <= 57 then
                        digits = digits .. rawChar(d)
                        j = j + 1
                    else
                        break
                    end
                end
                out[#out+1] = tonumber(digits) % 256
                i = j
            else
                out[#out+1] = nxt or 92
                i = i + 2
            end
        else
            out[#out+1] = c
            i = i + 1
        end
    end
    return out
end

function VM.extractPolSecStrings(source)
    if type(source) ~= "string" then return {} end
    local results = {}

    -- Find escaped byte-string literals of at least 8 bytes
    local byteStrings = {}
    for raw in rawGmatch(source, '"(([^"\\]|\\.)*)"') do
        local parsed = parseLuaByteString(raw)
        if #parsed >= 8 then
            byteStrings[#byteStrings + 1] = parsed
        end
    end

    -- XOR pairs that appear adjacent
    for i = 1, #byteStrings do
        for j = i + 1, #byteStrings do
            local a, b = byteStrings[i], byteStrings[j]
            local n = math.min(#a, #b)
            if n >= 8 then
                local decoded = {}
                for k = 1, n do
                    decoded[k] = bit32.bxor(a[k], b[k])
                end
                local s = rawConcat(decoded)
                local score = scoreText(s)
                if score >= 30 then
                    results[#results + 1] = { text = s, score = score }
                end
            end
        end
    end

    return results
end

function VM.stripPolSec(source)
    if type(source) ~= "string" then return source end
    local out = source
    out = rawGsub(out, "local function processItems%d+%b()", "--[[PolSec processItems removed]]")
    out = rawGsub(out, "local function runProtected%b()", "--[[PolSec runProtected removed]]")
    out = rawGsub(out, "local function getValue%d+%b()", "--[[PolSec getValue removed]]")
    out = rawGsub(out, "local function transformValue%b()", "--[[PolSec transformValue removed]]")
    out = rawGsub(out, 'game:GetService%("Players"%).LocalPlayer:Kick%b()', "--[[Kick removed]]")
    out = rawGsub(out, 'warn%(%"%%[ PolSec %%].-"%)', "--[[PolSec warn removed]]")
    return out
end

function VM.decodePolSec(source)
    if type(source) ~= "string" then return nil end
    local ok = rawFind(source, "processItems", 1, true) ~= nil
        or rawFind(source, "PolSec", 1, true) ~= nil
        or rawFind(source, "BzIs_vYBaEohYSz", 1, true) ~= nil
    if not ok then return nil end

    local strings = VM.extractPolSecStrings(source)
    local stripped = VM.stripPolSec(source)

    local result = {
        type = "PolSec",
        strings = strings,
        stripped = stripped,
        score = #strings * 10,
    }

    return result
end

-- 4g.  Moonveil decoder

local function detectMoonveil(source)
    if type(source) ~= "string" then return false end
    local hints = {
        "Moonveil",
        "moonveil",
        "MOONVEIL",
        "MoonVeil",
    }
    for _, h in ipairs(hints) do
        if rawFind(source, h, 1, true) then return true end
    end
    -- Structural hints: Moonveil is LuaVM-based with base64 payload + char chains
    if rawFind(source, "byte%(", 1, false)
        and rawFind(source, "char%(", 1, false)
        and rawFind(source, "getfenv", 1, true)
        and #source > 5000 then
        -- Too generic; only count as moonveil if combined with other markers
        local markers = 0
        if rawFind(source, "table%.concat", 1, false) then markers = markers + 1 end
        if rawFind(source, "string%.rep", 1, false) then markers = markers + 1 end
        if rawFind(source, "loadstring", 1, true) then markers = markers + 1 end
        if rawFind(source, "bit32", 1, true) then markers = markers + 1 end
        if markers >= 3 and #source > 50000 then
            return true
        end
    end
    return false
end

function VM.decodeMoonveil(source)
    if not detectMoonveil(source) then return nil end

    -- Try to extract base64-encoded payloads
    local payloads = {}
    for chunk in rawGmatch(source, '[A-Za-z0-9+/=_-]+') do
        if #chunk >= 200 then
            local decoded = VM.base64(chunk)
            if decoded and #decoded > 64 then
                payloads[#payloads + 1] = decoded
            end
        end
    end

    -- Try to extract XOR'd string chains
    local strings = VM.extractPolSecStrings(source)

    local result = {
        type = "Moonveil",
        payloads = payloads,
        strings = strings,
        score = #payloads * 20 + #strings * 5,
    }

    -- Try Luraph decode on any payload
    for _, p in ipairs(payloads) do
        local chunk = VM.decodeLuraph(p)
        if chunk then
            result.luraphChunk = chunk
            result.score = result.score + 100
            break
        end
    end

    return result
end

-- 4h.  Universal detection

function VM.detectObfuscator(source)
    if type(source) ~= "string" then return {} end
    local found = {}

    if rawSub(source, 1, 3) == "LPH"
        or rawFind(source, "LPH_OBFUSCATED", 1, true)
        or rawFind(source, "LPH_ENCSTR", 1, true)
        or rawFind(source, "LPH_ENCNUM", 1, true)
        or rawFind(source, "LPH_JIT", 1, true) then
        found.Luraph = true
    end

    if rawFind(source, "PolSec", 1, true)
        or rawFind(source, "BzIs_vYBaEohYSz", 1, true)
        or rawFind(source, "processItems", 1, true)
        or rawFind(source, "runProtected", 1, true) then
        found.PolSec = true
    end

    if detectMoonveil(source) then
        found.Moonveil = true
    end

    if rawFind(source, "api.luarmor.net", 1, true)
        or rawFind(source, "luarmor", 1, true)
        or rawFind(source, "script_key", 1, true) then
        found.Luarmor = true
    end

    return found
end

function VM.decode(source)
    if type(source) ~= "string" then return nil end
    local detected = VM.detectObfuscator(source)
    local results = {}

    if detected.Luraph or rawSub(source, 1, 3) == "LPH" then
        local chunk = VM.decodeLuraph(source)
        if chunk then
            results.luraph = chunk
        end
    end

    if detected.PolSec then
        local ps = VM.decodePolSec(source)
        if ps then
            results.polsec = ps
        end
    end

    if detected.Moonveil then
        local mv = VM.decodeMoonveil(source)
        if mv then
            results.moonveil = mv
            if mv.luraphChunk and not results.luraph then
                results.luraph = mv.luraphChunk
            end
        end
    end

    return results
end

--=====================================================================
-- 5.  STRING ANALYSIS
--=====================================================================

local SOURCE_HINTS = {
    "local ", "function", "return", "end", "then", "else", "elseif",
    "for ", "while ", "repeat", "until", "do ", "if ", "nil ", "true",
    "false", "self", "break", "goto", "::", "and ", "or ", "not ",
    "pcall", "loadstring", "getfenv", "setfenv", "require",
    "typeof", "task.", "wait(", "spawn(", "game", "workspace",
}

local function scoreSource(s)
    if type(s) ~= "string" then return 0 end
    if #s < 6 then return 0 end
    local total = math.min(#s, 8192)
    local printable = 0
    for i = 1, total do
        local b = rawByte(s, i)
        if b == 9 or b == 10 or b == 13 or (b >= 32 and b < 127) then
            printable = printable + 1
        end
    end
    if printable / total < 0.9 then return 0 end
    local score = 0
    for _, hint in ipairs(SOURCE_HINTS) do
        local _, n = rawGsub(s, hint, "")
        score = score + n * 3
    end
    local _, ends   = rawGsub(s, "%f[%w]end%f[%W]", "")
    local _, locals = rawGsub(s, "%f[%w]local%f[%W]", "")
    local _, funcs  = rawGsub(s, "%f[%w]function%f[%W]", "")
    score = score + ends * 2 + locals * 2 + funcs * 4
    local _, lines = rawGsub(s, "\n", "")
    if lines > 3 then score = score + lines end
    if rawMatch(s, "^[%x]+$") and #s > 32 then score = score - 50 end
    return score
end

local function addString(value, origin)
    if type(value) ~= "string" then return end
    if #value < 3 then return end
    if State.stringsSeen[value] then return end
    State.stringsSeen[value] = true
    State.stringsCount = State.stringsCount + 1
    local score = scoreSource(value)
    State.strings[#State.strings + 1] = {
        value = value,
        score = score,
        origin = origin or "unknown",
    }
end

local function sortedStrings()
    local copy = {}
    for i, v in ipairs(State.strings) do copy[i] = v end
    table.sort(copy, function(a, b)
        if a.score ~= b.score then return a.score > b.score end
        return #a.value > #b.value
    end)
    return copy
end

local function bestSource()
    for _, item in ipairs(sortedStrings()) do
        if item.score >= 40 then return item end
    end
    return nil
end

