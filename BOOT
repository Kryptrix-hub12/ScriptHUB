-- 4a.  Multi-encoding layer decoders

function VM.base85(encoded)
    if type(encoded) ~= "string" then return nil end
    local payload = encoded
    if rawSub(payload, 1, 3) == "LPH" then
        payload = rawSub(payload, 5)
    end
    payload = rawGsub(payload, "z", "!!!!!")
    local out = {}
    local i, n = 1, #payload
    while i + 4 <= n do
        local a = rawByte(payload, i)   - 33
        local b = rawByte(payload, i+1) - 33
        local c = rawByte(payload, i+2) - 33
        local d = rawByte(payload, i+3) - 33
        local e = rawByte(payload, i+4) - 33
        if a < 0 or b < 0 or c < 0 or d < 0 or e < 0 or
           a > 84 or b > 84 or c > 84 or d > 84 or e > 84 then
            return nil
        end
        local v = a * 52200625 + b * 614125 + c * 7225 + d * 85 + e
        out[#out+1] = rawChar(
            math.floor(v / 16777216) % 256,
            math.floor(v / 65536) % 256,
            math.floor(v / 256) % 256,
            v % 256
        )
        i = i + 5
    end
    return rawConcat(out)
end

function VM.base85Alt(encoded)
    if type(encoded) ~= "string" then return nil end
    local payload = encoded
    if rawSub(payload, 1, 4) == "LPH!" then
        payload = rawSub(payload, 5)
    end
    payload = rawGsub(payload, "z", "!!!!!")
    local out = {}
    local i, n = 1, #payload
    while i + 4 <= n do
        local a = rawByte(payload, i)   - 33
        local b = rawByte(payload, i+1) - 33
        local c = rawByte(payload, i+2) - 33
        local d = rawByte(payload, i+3) - 33
        local e = rawByte(payload, i+4) - 33
        local v = ((a * 85 + b) * 85 + c) * 85 + d
        v = v * 85 + e
        out[#out+1] = rawChar(
            math.floor(v / 16777216) % 256,
            math.floor(v / 65536) % 256,
