local function classifyTag(tag, profile)
    if profile.dispatchMode == 1 then
        if tag == profile.floatTag then return "number" end
        if tag < profile.floatTag then return "boolean" end
        if tag == profile.stringTag then return "string" end
        return "integer"
    elseif profile.dispatchMode == 2 then
        if tag <= profile.stringTag then
            if tag == profile.stringTag then return "string" end
            return "number"
        end
        if profile.integerTag and tag == profile.integerTag then
            return "integer"
        end
        return "boolean"
    else
        if tag == profile.stringTag then return "string" end
        if profile.floatTag and tag == profile.floatTag then return "number" end
        if profile.integerTag and tag == profile.integerTag then return "integer" end
        return "boolean"
    end
end

local function deserializeLuraph(data, profile)
    local R = makeReader(data)

    local rawCount = R.varint()
    local count = rawCount - profile.constantsOffset
    if count < 0 or count > 2000000 then
        return nil
    end

    R.byte()
    local constants = {}
    for i = 1, count do
        local tag = R.byte()
        local datatype = classifyTag(tag, profile)
        local entry = { type = datatype }
        if datatype == "number" then
            local n = R.float64()
            if profile.transform and n ~= 0 then n = -n end
            entry.value = n
        elseif datatype == "boolean" then
            local b = R.byte() == 1
            if profile.transform then b = not b end
            entry.value = b
        elseif datatype == "string" then
            local raw = R.rawBytes()
            entry.raw = raw
            if profile.decrypt then
                entry.value = VM.recoverString(raw)
            else
                entry.value = raw
            end
        elseif datatype == "integer" then
            entry.value = R.int64()
        end
        constants[i] = entry
    end

    local rawProtoCount = R.varint()
    local protoCount = rawProtoCount - profile.prototypesOffset
    if protoCount < 0 or protoCount > 200000 then
        return nil
    end

    local protos = {}
    for i = 1, protoCount do
        local metaCount = R.varint()
        if metaCount > 256 then return nil end
        for _ = 1, metaCount do R.varint() end

        local rawInstr = R.varint()
        local instrCount = rawInstr - profile.instructionsOffset
        if instrCount < 0 or instrCount > 5000000 then
            return nil
        end

        local proto = {
            opcodes = {},
            raw = {},
            instructionCount = instrCount,
        }

        for idx = 1, instrCount do
            proto.raw[idx] = {
                C = R.varint(),
                A = R.varint(),
                B = R.varint(),
            }
            proto.opcodes[idx] = R.varint()
        end

        proto.stackSize = R.varint()

        local lineEntries = R.uint32()
        if lineEntries > 1000000 then return nil end
        for _ = 1, lineEntries do
            local raw = R.uint32()
            if raw % 2 == 1 then
                R.uint32()
                R.uint32()
            end
        end

        proto.numParams = R.varint()
        proto.name = "P" .. i
        protos[i] = proto
    end

    local rawEntryIndex = R.varint()
    local entryIndex = rawEntryIndex - 1

    return {
        constants = constants,
        prototypes = protos,
        entryIndex = entryIndex,
        entryProto = protos[entryIndex + 1],
        profile = profile,
    }
end

local function scoreLuraphChunk(chunk)
    if not chunk or not chunk.prototypes or #chunk.prototypes == 0 then
        return -math.huge
    end

    local score = 0
    if chunk.entryProto then score = score + 60 end
    if chunk.entryIndex and chunk.entryIndex >= 0 then score = score + 30 end
    score = score + math.min(#chunk.prototypes * 4, 200)
    score = score + math.min(#chunk.constants, 200)

    local totalInstr = 0
    local opSet = {}
    for _, p in ipairs(chunk.prototypes) do
        if p.instructionCount <= 0 then return -math.huge end
        totalInstr = totalInstr + p.instructionCount
        for i = 1, math.min(p.instructionCount, #p.opcodes) do
            opSet[p.opcodes[i]] = true
        end
    end
    score = score + math.min(math.floor(totalInstr / 10), 200)

    local opCount = 0
    for _ in pairs(opSet) do opCount = opCount + 1 end
    score = score + math.min(opCount * 5, 200)

    local strs, goodStrs = 0, 0
    for _, c in ipairs(chunk.constants) do
        if c.type == "string" and type(c.value) == "string" then
            strs = strs + 1
            if #c.value >= 2 then
                local printable = 0
                for i = 1, #c.value do
                    local b = rawByte(c.value, i)
                    if b == 9 or b == 10 or b == 13 or (b >= 32 and b <= 126) then
                        printable = printable + 1
                    end
                end
                if printable >= #c.value * 0.75 then
                    goodStrs = goodStrs + 1
                end
            end
        end
    end
    if strs > 0 then
        score = score + math.min(strs * 3, 100)
        if goodStrs * 2 >= strs then score = score + 60 end
    end

    return score
end

function VM.decodeLuraph(blob)
    if type(blob) ~= "string" or #blob < 64 then
        return nil, "blob too short"
    end

    local candidates = {}

    local ok, b85 = pcall(VM.base85, blob)
    if ok and b85 and #b85 > 64 then
        candidates[#candidates + 1] = { data = b85, encoder = "base85" }
    end

    local ok2, b85a = pcall(VM.base85Alt, blob)
    if ok2 and b85a and #b85a > 64 then
        candidates[#candidates + 1] = { data = b85a, encoder = "base85-alt" }
    end

    local ok3, b64 = pcall(VM.base64, blob)
    if ok3 and b64 and #b64 > 64 then
        candidates[#candidates + 1] = { data = b64, encoder = "base64" }
    end

    local ok4, hx = pcall(VM.hexDecode, blob)
    if ok4 and hx and #hx > 64 then
        candidates[#candidates + 1] = { data = hx, encoder = "hex" }
    end

    if #candidates == 0 then
        return nil, "no decoder succeeded"
    end

    local best, bestScore, bestInfo = nil, -math.huge, nil
    for _, cand in ipairs(candidates) do
        for _, profile in ipairs(LURAPH_PROFILES) do
            local ok5, chunk = pcall(deserializeLuraph, cand.data, profile)
            if ok5 and chunk then
                local sc = scoreLuraphChunk(chunk)
                if sc > bestScore then
                    best = chunk
                    bestScore = sc
                    bestInfo = cand.encoder .. "/" .. profile.name
                end
            end
        end
    end

    if best then
        best.encoder = bestInfo
        best.score = bestScore
        return best
    end
    return nil, "all attempts scored -inf"
end

