local Bypass = { enabled = false }

function Bypass.enable()
    if Bypass.enabled then return end
    local genv = getGenv()
    if not genv then return end

    if type(genv.checkcaller) == "function" then
        genv.checkcaller = function() return false end
    end

    if type(genv.warn) == "function" then
        local realWarn = genv.warn
        local wrapper = newC(function(...)
            local first = tostring((...))
            if rawFind(first, "PolSec", 1, true)
                or rawFind(first, "tamper", 1, true)
                or rawFind(first, "Tamper", 1, true) then
                State.warnsFiltered = State.warnsFiltered + 1
                return
            end
            return realWarn(...)
        end)
        genv.warn = wrapper
    end

    local ok, Players = pcall(function()
        return game:GetService("Players")
    end)
    if ok and Players then
        local lp = Players.LocalPlayer
        if lp and type(hookmetamethod) == "function" then
            pcall(hookmetamethod, lp, "__index", function(_, k)
                if k == "Kick" then
                    return function()
                        State.kicksBlocked = State.kicksBlocked + 1
                        log("blocked Kick() #%d", State.kicksBlocked)
                    end
                end
            end)
        end
    end

    Bypass.enabled = true
    log("bypass enabled")
end

--=====================================================================
-- 7.  FETCHER + HOOKS
--=====================================================================

local Hooks = { installed = false }

local function captureChunk(source, name, kind)
    if type(source) ~= "string" then return end
    State.chunks[#State.chunks + 1] = {
        source = source,
        name = name or "?",
        kind = kind or "loadstring",
    }
    addString(source, kind .. ":" .. tostring(name))

    -- Detect obfuscator
    local detected = VM.detectObfuscator(source)
    for k, _ in pairs(detected) do
        State.detected[k] = true
    end

    -- Auto-decode everything
    local decoded = VM.decode(source)
    if decoded then
        if decoded.luraph and not State.luraphOk then
            State.luraph = decoded.luraph
            State.luraphOk = true
            log("Luraph decoded: %d protos, %d constants",
                #decoded.luraph.prototypes, #decoded.luraph.constants)
            for _, c in ipairs(decoded.luraph.constants) do
                if c.type == "string" and type(c.value) == "string" then
                    addString(c.value, "luraph:const")
                end
            end
        end
        if decoded.polsec and not State.polsecOk then
            State.polsec = decoded.polsec
            State.polsecOk = true
            log("PolSec decoded: %d strings", #decoded.polsec.strings)
            for _, s in ipairs(decoded.polsec.strings) do
                addString(s.text, "polsec:xor")
            end
        end
        if decoded.moonveil and not State.moonveilOk then
            State.moonveil = decoded.moonveil
            State.moonveilOk = true
            log("Moonveil decoded: %d payloads", #decoded.moonveil.payloads)
            for _, s in ipairs(decoded.moonveil.strings) do
                addString(s.text, "moonveil:xor")
            end
        end
    end
end

function Hooks.install()
    if Hooks.installed then return end
    local genv = getGenv()
    if not genv then return end

    if type(genv.loadstring) == "function" then
        local real = genv.loadstring
        local wrapper = newC(function(source, chunkname)
            if type(source) == "string" then
                State.fetcherIndex = State.fetcherIndex + 1
                State.fetcherPicks[State.fetcherIndex] = source
                captureChunk(source, chunkname, "loadstring")
            end
            return real(source, chunkname)
        end)
        genv.loadstring = wrapper
    end

    if type(genv.load) == "function" then
        local real = genv.load
        local wrapper = newC(function(chunk, chunkname, mode, env)
            if type(chunk) == "string" then
                captureChunk(chunk, chunkname, "load")
            end
            return real(chunk, chunkname, mode, env)
        end)
        genv.load = wrapper
    end

    if type(string.char) == "function" then
        local realChar = string.char
        string.char = newC(function(...)
            local r = realChar(...)
            State.charCalls[#State.charCalls + 1] = r
            if #r >= 4 then addString(r, "string.char") end
            return r
        end)
    end

    if type(genv.request) == "function" then
        local real = genv.request
        genv.request = newC(function(opts)
            local r = real(opts)
            local url = type(opts) == "table" and opts.Url or tostring(opts)
            if type(url) == "string" then
                local low = rawLower(url)
                if rawFind(low, "luarmor", 1, true) then
                    if not State.luarmorLoader then
                        State.luarmorLoader = url
                    end
                    if type(r) == "table" and r.Body then
                        captureChunk(r.Body, url, "http:loader")
                    end
                end
                if rawFind(low, "api.luarmor.net/files", 1, true) then
                    State.luarmorPayload = url
                    if type(r) == "table" and r.Body then
                        captureChunk(r.Body, url, "http:payload")
                    end
                end
            end
            return r
        end)
    end

    Hooks.installed = true
    log("hooks + fetcher installed")
end

