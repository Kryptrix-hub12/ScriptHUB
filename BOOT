local function applyWatermark(src)
    if type(src) ~= "string" then return src end
    local header = {}
    for i = 1, CONFIG.WatermarkLines do
        header[i] = "-- " .. CONFIG.WatermarkText
    end
    header[#header + 1] = ""
    return rawConcat(header, "\n") .. "\n" .. src
end

--=====================================================================
-- 9.  REPORT
--=====================================================================

local function buildReport(loadstringText, status)
    local buf = {}
    buf[#buf+1] = "================================================================"
    buf[#buf+1] = "  GOJO DUMPER  —  REPORT"
    buf[#buf+1] = "================================================================"
    buf[#buf+1] = "Timestamp: " .. tostring(os.date and os.date("%Y-%m-%d %H:%M:%S") or "?")
    buf[#buf+1] = "Status:    " .. tostring(status or "ok")
    buf[#buf+1] = ""

    buf[#buf+1] = "DETECTED OBFUSCATORS:"
    local detList = {}
    for k, _ in pairs(State.detected) do detList[#detList + 1] = k end
    if #detList == 0 then
        buf[#buf+1] = "  (none)"
    else
        for _, k in ipairs(detList) do
            buf[#buf+1] = "  - " .. k
        end
    end
    buf[#buf+1] = ""

    buf[#buf+1] = "LOADSTRING INPUT:"
    buf[#buf+1] = tostring(loadstringText or "")
    buf[#buf+1] = ""

    if State.luraph then
        buf[#buf+1] = "================================================================"
        buf[#buf+1] = "  LURAPH VM  —  FULL DISASSEMBLY"
        buf[#buf+1] = "================================================================"
        local ok, lifted = pcall(VM.liftLuraph, State.luraph)
        if ok and lifted then
            buf[#buf+1] = lifted
        else
            buf[#buf+1] = "-- lift failed: " .. tostring(lifted)
        end
        buf[#buf+1] = ""
    end

    if State.polsec then
        buf[#buf+1] = "================================================================"
        buf[#buf+1] = "  POLSEC  —  DECODED XOR STRINGS"
        buf[#buf+1] = "================================================================"
        for i, s in ipairs(State.polsec.strings) do
            buf[#buf+1] = rawFormat("[%03d] score=%d  %q", i, s.score, s.text)
        end
        buf[#buf+1] = ""
        buf[#buf+1] = "-- POLSEC STRIPPED SOURCE --"
        buf[#buf+1] = State.polsec.stripped
        buf[#buf+1] = ""
    end

    if State.moonveil then
        buf[#buf+1] = "================================================================"
        buf[#buf+1] = "  MOONVEIL  —  DECODED"
        buf[#buf+1] = "================================================================"
        buf[#buf+1] = "Payloads extracted: " .. tostring(#State.moonveil.payloads)
        for i, p in ipairs(State.moonveil.payloads) do
            buf[#buf+1] = ""
            buf[#buf+1] = "-- PAYLOAD #" .. i .. " (" .. #p .. " bytes) --"
            buf[#buf+1] = p
        end
        buf[#buf+1] = ""
    end

    buf[#buf+1] = "================================================================"
    buf[#buf+1] = "  FETCHER CAPTURES (" .. tostring(State.fetcherIndex) .. ")"
    buf[#buf+1] = "================================================================"
    for i, c in ipairs(State.fetcherPicks) do
        buf[#buf+1] = ""
        buf[#buf+1] = "-- FETCH #" .. i .. " (" .. #c .. " bytes) --"
        buf[#buf+1] = c
    end

    buf[#buf+1] = ""
    buf[#buf+1] = "================================================================"
    buf[#buf+1] = "  CAPTURED CHUNKS (" .. #State.chunks .. ")"
    buf[#buf+1] = "================================================================"
    for i, c in ipairs(State.chunks) do
        buf[#buf+1] = ""
        buf[#buf+1] = "-- chunk " .. i .. " | " .. tostring(c.name)
            .. " | " .. tostring(c.kind) .. " | " .. #c.source .. " bytes --"
        buf[#buf+1] = c.source
    end

    buf[#buf+1] = ""
    buf[#buf+1] = "================================================================"
    buf[#buf+1] = "  BEST SOURCE CANDIDATE"
    buf[#buf+1] = "================================================================"
    local best = bestSource()
    if best then
        buf[#buf+1] = "-- score=" .. tostring(best.score)
            .. " origin=" .. tostring(best.origin)
            .. " size=" .. tostring(#best.value)
        buf[#buf+1] = best.value
    else
        buf[#buf+1] = "(none found)"
    end

    if #State.charCalls > 0 then
        buf[#buf+1] = ""
        buf[#buf+1] = "================================================================"
        buf[#buf+1] = "  CHAR-BUILT PAYLOAD"
        buf[#buf+1] = "================================================================"
        buf[#buf+1] = rawConcat(State.charCalls, "")
    end

    buf[#buf+1] = ""
    buf[#buf+1] = "================================================================"
    buf[#buf+1] = "  TOP STRINGS (" .. tostring(State.stringsCount) .. " total)"
    buf[#buf+1] = "================================================================"
    local sorted = sortedStrings()
    local limit = math.min(#sorted, CONFIG.MaxReportStrings)
    for i = 1, limit do
        local item = sorted[i]
        local pv = #item.value > 200 and (rawSub(item.value, 1, 197) .. "...") or item.value
        buf[#buf+1] = rawFormat("[%04d] score=%-4d origin=%-24s size=%d",
            i, item.score, item.origin, #item.value)
        buf[#buf+1] = rawFormat("  %q", pv)
    end

    buf[#buf+1] = ""
    buf[#buf+1] = "================================================================"
    buf[#buf+1] = "  STATS"
    buf[#buf+1] = "================================================================"
    buf[#buf+1] = "Chunks:           " .. #State.chunks
    buf[#buf+1] = "Fetcher picks:    " .. State.fetcherIndex
    buf[#buf+1] = "Unique strings:   " .. State.stringsCount
    buf[#buf+1] = "Luraph decoded:   " .. tostring(State.luraphOk)
    buf[#buf+1] = "PolSec decoded:   " .. tostring(State.polsecOk)
    buf[#buf+1] = "Moonveil decoded: " .. tostring(State.moonveilOk)
    buf[#buf+1] = "Kicks blocked:    " .. State.kicksBlocked
    buf[#buf+1] = "Warns filtered:   " .. State.warnsFiltered

    return rawConcat(buf, "\n")
end

--=====================================================================
-- 10.  PIPELINE
--=====================================================================

local function runPipeline(loadstringText)
    log("pipeline start")

    pcall(Bypass.enable)
    pcall(Hooks.install)

    local execOk, execErr = pcall(function()
        local fn = loadstring(loadstringText)
        if type(fn) ~= "function" then
            error("loadstring returned nil")
        end
        return fn()
    end)

    if not execOk then
        log("payload error: %s", tostring(execErr))
    end

    -- Wait 2.3s before decoding to let the payload fully settle
    log("waiting %.1fs before decoding...", CONFIG.PreDecodeDelay)
    waitFn(CONFIG.PreDecodeDelay)

    -- Wait for decode to settle
    local waited = 0
    while waited < CONFIG.MaxWait do
        waitFn(CONFIG.DecodeInterval)
        waited = waited + CONFIG.DecodeInterval
        if State.luraphOk or State.polsecOk or State.moonveilOk then
            waitFn(1)
            break
        end
    end

    local status = execOk and "ok" or ("payload_error: " .. tostring(execErr))
    local report = buildReport(loadstringText, status)
    report = applyWatermark(report)

    local path = nextOutputPath()
    local saved = writeFileSafe(path, report)

    log("pipeline complete: saved=%s path=%s chunks=%d luraph=%s polsec=%s moonveil=%s",
        tostring(saved), path, #State.chunks,
        tostring(State.luraphOk), tostring(State.polsecOk), tostring(State.moonveilOk))

    return saved, path, report
end

