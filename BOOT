end

local B64_LOOKUP = {}
do
    local alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    for i = 1, #alpha do B64_LOOKUP[rawByte(alpha, i)] = i - 1 end
    B64_LOOKUP[rawByte("-")] = 62
    B64_LOOKUP[rawByte("_")] = 63
end

function VM.base64(data)
    if type(data) ~= "string" then return nil end
    data = rawGsub(data, "%s+", "")
    if rawFind(data, "[^A-Za-z0-9+/=_-]") then return nil end
    local out, buf, bits = {}, 0, 0
    for i = 1, #data do
        local c = rawByte(data, i)
        if c == 61 then break end
        local v = B64_LOOKUP[c]
        if v then
            buf = bit32.bor(bit32.lshift(buf, 6), v)
            bits = bits + 6
            if bits >= 8 then
                bits = bits - 8
                out[#out+1] = rawChar(bit32.band(bit32.rshift(buf, bits), 0xFF))
            end
        end
    end
    if #out < 16 then return nil end
    return rawConcat(out)
end

function VM.hexDecode(data)
    if type(data) ~= "string" then return nil end
    local cleaned = rawGsub(rawGsub(data, "0x", ""), "%s+", "")
    if #cleaned < 32 or #cleaned % 2 ~= 0 then return nil end
    if not rawMatch(cleaned, "^%x+$") then return nil end
    local out = {}
    for i = 1, #cleaned, 2 do
        out[#out+1] = rawChar(tonumber(rawSub(cleaned, i, i + 1), 16))
    end
    return rawConcat(out)
end

-- 4b.  Binary reader

local function makeReader(data)
    local pos = 0
    local n = #data
    local R = {}
    function R.byte()
        if pos >= n then return 0 end
        pos = pos + 1
        return rawByte(data, pos)
    end
    function R.uint32()
        local a = R.byte()
        local b = R.byte()
        local c = R.byte()
        local d = R.byte()
        return d * 16777216 + c * 65536 + b * 256 + a
    end
    function R.varint()
        local v, m = 0, 1
        for _ = 1, 10 do
            local b = R.byte()
            local p = b > 127 and (b - 128) or b
            v = v + p * m
            m = m * 128
            if b < 128 then break end
        end
        return v
    end
    function R.int64()
        local low = R.uint32()
        local high = R.uint32()
        local s = high >= 2147483648 and (high - 4294967296) or high
        return s * 4294967296 + low
    end
    function R.float64()
        local left = R.uint32()
        local right = R.uint32()
        if left == 0 and right == 0 then return 0.0 end
        local sign = math.floor(right / 2147483648) % 2
        local exp = math.floor(right / 1048576) % 2048
        local mant = (right % 1048576) * 4294967296 + left
        local isNorm = 1
        if exp == 0 then
            if mant == 0 then
                if sign == 1 then return -0.0 end
                return 0.0
            end
            isNorm = 0
            exp = 1
        elseif exp == 2047 then
            if mant == 0 then
                if sign == 1 then return -math.huge end
                return math.huge
            end
            return 0 / 0
        end
        local s = sign == 1 and -1.0 or 1.0
        return s * (2 ^ (exp - 1023)) * (mant / 4503599627370496.0 + isNorm)
    end
    function R.rawBytes()
        local len = R.varint()
        if len == 0 then return "" end
        if pos + len > n then len = n - pos end
        local s = rawSub(data, pos + 1, pos + len)
        pos = pos + len
        return s
    end
    return R
end

-- 4c.  LCG variants for Luraph string decryption

local function buildCharTable(initState, xorMask, a, c)
    local t = {}
    local state = initState
    local mask = xorMask
    for _ = 0, 255 do
        local idx = bit32.bxor(state, mask) % 256
        t[idx] = state % 256
        state = (a * state + c) % 256
    end
    return t
end

local function scoreText(s)
    if type(s) ~= "string" or #s == 0 then return 0 end
    local score, printable, alpha = 0, 0, 0
    for i = 1, #s do
        local b = rawByte(s, i)
        if b == 9 or b == 10 or b == 13 then
            printable = printable + 1
            score = score + 1
        elseif b >= 32 and b <= 126 then
            printable = printable + 1
            score = score + 2
            if (b >= 65 and b <= 90) or (b >= 97 and b <= 122) then
                alpha = alpha + 1
            end
        elseif b < 32 then
            score = score - 3
        else
            score = score + 1
        end
    end
    local pct = printable / #s
    if pct >= 0.9 then score = score + 25
    elseif pct >= 0.7 then score = score + 12
    else score = score - 20 end
    if alpha / #s >= 0.4 then score = score + 15 end
    return score
end

local LCG_VARIANTS = {
    { init = 0,   mask = 127, a = 65,  c = 117 },
    { init = 185, mask = 127, a = 65,  c = 117 },
    { init = 0,   mask = 255, a = 65,  c = 117 },
    { init = 0,   mask = 127, a = 17,  c = 43  },
    { init = 0,   mask = 127, a = 97,  c = 201 },
    { init = 22,  mask = 85,  a = 33,  c = 79  },
    { init = 74,  mask = 63,  a = 65,  c = 117 },
    { init = 0,   mask = 127, a = 129, c = 77  },
    { init = 100, mask = 191, a = 45,  c = 33  },
    { init = 50,  mask = 159, a = 89,  c = 153 },
}

local function decryptRawString(raw, variant)
    if #raw < 3 then return raw end
    local charTable = buildCharTable(variant.init, variant.mask, variant.a, variant.c)
    local key = rawByte(raw, 2)
    key = (variant.a * key + variant.c) % 256
    local out = {}
    for i = 3, #raw do
        local b = rawByte(raw, i)
        local idx = bit32.bxor(b, key) % 256
        out[#out+1] = rawChar(charTable[idx] or idx)
        key = (variant.a * key + variant.c) % 256
    end
    return rawConcat(out)
end

function VM.recoverString(raw)
    if type(raw) ~= "string" or #raw == 0 then return "" end
    if rawByte(raw, 1) == 0 then
        return rawSub(raw, 2)
    end
    local best, bestScore = nil, -math.huge
    for _, variant in ipairs(LCG_VARIANTS) do
        local ok, result = pcall(decryptRawString, raw, variant)
        if ok and result then
            local sc = scoreText(result)
            if sc > bestScore then
                best, bestScore = result, sc
            end
        end
    end
    return best or ""
end

