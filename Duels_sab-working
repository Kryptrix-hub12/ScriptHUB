-- Localized, unobtrusive speed labels: this only reads replicated velocity.
local labelData = {}
local function clearPlayerLabels(plr)
    local data = labelData[plr]
    if data then
        if data.connection then data.connection:Disconnect() end
        if data.gui then data.gui:Destroy() end
        labelData[plr] = nil
    end
end

local function addPlayerLabel(plr)
    if plr == player or not State.PlayerSpeedLabels or labelData[plr] then return end
    local character = plr.Character
    local head = character and character:FindFirstChild("Head")
    if not head then return end
    local old = head:FindFirstChild("EclipseSpeedLabel")
    if old then old:Destroy() end
    local gui = make("BillboardGui", {Name = "EclipseSpeedLabel", Size = UDim2.fromOffset(190, 38), StudsOffset = Vector3.new(0, 3.2, 0), AlwaysOnTop = true, Adornee = head}, head)
    local text = make("TextLabel", {Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = Config.Discord .. "\nSPEED 0.0", TextColor3 = C.bright, TextStrokeTransparency = 0.25, Font = Enum.Font.GothamBold, TextScaled = true}, gui)
    labelData[plr] = {gui = gui, text = text}
end

local function updateLabels()
    for plr, data in pairs(labelData) do
        local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
        if not root or not data.gui.Parent then clearPlayerLabels(plr) else
            local velocity = root.AssemblyLinearVelocity
            local horizontal = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
            data.text.Text = Config.Discord .. "\nSPEED " .. string.format("%.1f", horizontal)
        end
    end
end

refreshLabels = function()
    if not State.PlayerSpeedLabels then
        for plr in pairs(labelData) do clearPlayerLabels(plr) end
        return
    end
    for _, plr in ipairs(Players:GetPlayers()) do addPlayerLabel(plr) end
end

Players.PlayerAdded:Connect(function(plr)
