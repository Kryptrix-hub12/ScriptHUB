    local input = make("TextBox", {Size = UDim2.fromOffset(66, 23), Position = UDim2.new(1, -74, 0.5, -11), BackgroundColor3 = C.black, Text = tostring(value), TextColor3 = C.bright, Font = Enum.Font.Code, TextSize = 10, ClearTextOnFocus = false}, item); corner(input, 6)
    input.FocusLost:Connect(function() local n = tonumber(input.Text); if n then callback(n) else input.Text = tostring(value) end end)
    return input
end

