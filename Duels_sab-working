local function draggable(frame, handle)
    local dragging, startInput, startPosition
    handle = handle or frame
    handle.InputBegan:Connect(function(input)
        if State.UILocked then return end
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = true; startInput = input.Position; startPosition = frame.Position end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - startInput
            frame.Position = UDim2.new(startPosition.X.Scale, startPosition.X.Offset + delta.X, startPosition.Y.Scale, startPosition.Y.Offset + delta.Y)
        end
    end)
    UserInputService.InputEnded:Connect(function(input) if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
end
draggable(root, header); draggable(quick, quick)

local function keyMatches(input, key) return input.KeyCode == key end
UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed or State.UILocked or UserInputService:GetFocusedTextBox() then return end
    if keyMatches(input, Enum.KeyCode.LeftControl) then root.Visible = not root.Visible; quick.Visible = root.Visible; chip.Visible = not root.Visible; return end
    if keyMatches(input, Enum.KeyCode.Q) then State.Carry = not State.Carry; runButtonPair(buttonCarryOn, buttonCarryOff, State.Carry); setQuickVisual("carrySpeed", State.Carry)
    elseif keyMatches(input, Enum.KeyCode.R) then State.Lagger = not State.Lagger; runButtonPair(buttonLaggerOn, buttonLaggerOff, State.Lagger); setQuickVisual("laggerMode", State.Lagger)
    elseif keyMatches(input, Enum.KeyCode.Z) then State.AutoLeft = not State.AutoLeft; runButtonPair(buttonAutoLeftOn, buttonAutoLeftOff, State.AutoLeft); setQuickVisual("autoLeft", State.AutoLeft)
    elseif keyMatches(input, Enum.KeyCode.C) then State.AutoRight = not State.AutoRight; runButtonPair(buttonAutoRightOn, buttonAutoRightOff, State.AutoRight); setQuickVisual("autoRight", State.AutoRight)
    elseif keyMatches(input, Enum.KeyCode.E) then State.AutoBat = not State.AutoBat; runButtonPair(buttonAimbotOn, buttonAimbotOff, State.AutoBat); setQuickVisual("aimbot", State.AutoBat)
    elseif keyMatches(input, Enum.KeyCode.V) then State.BatV2 = not State.BatV2; runButtonPair(buttonBatV2On, buttonBatV2Off, State.BatV2)
    elseif keyMatches(input, Enum.KeyCode.F) then buttonTPDownAction()
    elseif keyMatches(input, Enum.KeyCode.T) then buttonInstantResetAction() end
end)

