local function tab(name, order)
    local button = make("TextButton", {Size = UDim2.new(0.25, -3, 1, 0), Position = UDim2.new((order - 1) * 0.25, order == 1 and 0 or 2, 0, 0), BackgroundColor3 = C.row, Text = name, TextColor3 = C.muted, Font = Enum.Font.GothamBold, TextSize = 10, AutoButtonColor = false}, tabs)
    corner(button, 7); tabButtons[name] = button
    local panel = make("Frame", {Name = name .. "Page", Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Visible = false, LayoutOrder = order}, page)
    make("UIListLayout", {Padding = UDim.new(0, 5), SortOrder = Enum.SortOrder.LayoutOrder}, panel)
    pages[name] = panel
    button.MouseButton1Click:Connect(function()
        for key, p in pairs(pages) do p.Visible = key == name end
        for key, b in pairs(tabButtons) do b.BackgroundColor3 = key == name and C.orange or C.row; b.TextColor3 = key == name and C.black or C.muted end
        page.CanvasPosition = Vector2.zero
    end)
    return panel
end

