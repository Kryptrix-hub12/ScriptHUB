local function row(parent, label, value, callback)
    local item = make("Frame", {Size = UDim2.new(1, 0, 0, 35), BackgroundColor3 = C.row, BackgroundTransparency = 0.12}, parent); corner(item, 8); stroke(item, Color3.fromRGB(78, 39, 25), 0.8)
    make("TextLabel", {Size = UDim2.new(1, -80, 1, 0), Position = UDim2.fromOffset(10, 0), BackgroundTransparency = 1, Text = label, TextColor3 = C.white, Font = Enum.Font.GothamBold, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left}, item)
    local button = make("TextButton", {Size = UDim2.fromOffset(58, 23), Position = UDim2.new(1, -68, 0.5, -11), BackgroundColor3 = value and C.orange or C.black, Text = value and "ON" or "OFF", TextColor3 = value and C.black or C.muted, Font = Enum.Font.Code, TextSize = 10, AutoButtonColor = false}, item); corner(button, 6)
    local state = value
    local function set(on)
        state = on; button.Text = on and "ON" or "OFF"; button.BackgroundColor3 = on and C.orange or C.black; button.TextColor3 = on and C.black or C.muted
    end
    button.MouseButton1Click:Connect(function() set(not state); if callback then callback(state) end end)
    return set
end

local function valueRow(parent, label, value, callback)
    local item = make("Frame", {Size = UDim2.new(1, 0, 0, 35), BackgroundColor3 = C.row, BackgroundTransparency = 0.12}, parent); corner(item, 8); stroke(item, Color3.fromRGB(78, 39, 25), 0.8)
