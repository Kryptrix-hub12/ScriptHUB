-- Mobile quick rail: the complete Eclipse action board from the reference layout.
-- Every action still goes through an explicit hook in the user's own experience.
local quick = make("Frame", {Size = UDim2.fromOffset(148, 300), Position = UDim2.new(1, -164, 0.5, -150), BackgroundTransparency = 1, Active = true}, gui)
local quickLayout = make("UIGridLayout", {CellSize = UDim2.fromOffset(68, 52), CellPadding = UDim2.fromOffset(6, 6), FillDirection = Enum.FillDirection.Horizontal, FillDirectionMaxCells = 2, HorizontalAlignment = Enum.HorizontalAlignment.Center, VerticalAlignment = Enum.VerticalAlignment.Center, SortOrder = Enum.SortOrder.LayoutOrder}, quick)
local quickStates = {}
local quickOrder = 0

local function setQuickVisual(key, on)
    local data = quickStates[key]
    if not data then return end
    data.on = on
    data.button.BackgroundColor3 = on and C.orange or C.panel
    data.button.TextColor3 = on and C.black or C.bright
    data.button.TextStrokeTransparency = on and 1 or 0.55
end

local function quickToggle(key, text, hookName, valueFactory, initial, changeHandler)
    quickOrder = quickOrder + 1
    local button = make("TextButton", {BackgroundColor3 = initial and C.orange or C.panel, Text = text, TextColor3 = initial and C.black or C.bright, Font = Enum.Font.GothamBold, TextSize = 9, TextWrapped = true, TextStrokeTransparency = initial and 1 or 0.55, AutoButtonColor = false, LayoutOrder = quickOrder}, quick)
    corner(button, 10); stroke(button, C.orange, 1)
    quickStates[key] = {button = button, on = initial == true}
    button.MouseButton1Click:Connect(function()
        local nextState = not quickStates[key].on
        setQuickVisual(key, nextState)
        if changeHandler then changeHandler(nextState) else callHook(hookName, valueFactory and valueFactory(nextState) or nextState) end
    end)
    return button
end

local function quickAction(key, text, callback)
    quickOrder = quickOrder + 1
    local button = make("TextButton", {BackgroundColor3 = C.panel, Text = text, TextColor3 = C.bright, Font = Enum.Font.GothamBold, TextSize = 9, TextWrapped = true, TextStrokeTransparency = 0.55, AutoButtonColor = false, LayoutOrder = quickOrder}, quick)
    corner(button, 10); stroke(button, C.orange, 1)
    quickStates[key] = {button = button, on = false}
    button.MouseButton1Click:Connect(callback)
    return button
end

