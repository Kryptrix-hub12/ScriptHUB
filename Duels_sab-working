local function getHook(name)
    if type(name) ~= "string" or name:sub(1, 12) ~= "EclipseDuels" then return nil end
    local folder = ReplicatedStorage:FindFirstChild("EclipseDuelsHooks")
    local hook = folder and folder:FindFirstChild(name)
    if hook and (hook:IsA("BindableEvent") or hook:IsA("BindableFunction") or hook:IsA("RemoteEvent") or hook:IsA("RemoteFunction")) then
        return hook
    end
    return nil
end

local statusLabel
local function status(text)
    if statusLabel and statusLabel.Parent then statusLabel.Text = text end
end

local function callHook(name, ...)
    local hook = getHook(name)
    if not hook then status("HOOK MISSING") return false end
    local args = {...}
    local ok = pcall(function()
        if hook:IsA("BindableEvent") then hook:Fire(player, table.unpack(args))
        elseif hook:IsA("BindableFunction") then hook:Invoke(player, table.unpack(args))
        elseif hook:IsA("RemoteEvent") then hook:FireServer(table.unpack(args))
        else hook:InvokeServer(table.unpack(args)) end
    end)
    status(ok and "HOOK OK" or "HOOK ERROR")
    return ok
end

